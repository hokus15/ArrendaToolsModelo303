import unittest

from arrendatools.modelo303.data import Modelo303Datos, Period
from arrendatools.modelo303.factory import Modelo303Factory


class TestTaxYear2026Generator(unittest.TestCase):
    def setUp(self):
        self.anyo_fiscal = 2026
        # Datos base válidos
        self.datos_validos = {
            "period": Period.THIRD_QUARTER,
            "version": "v1.0",
            "developer_nif": "12345678X",
            "taxpayer_legal_name": "DE LOS PALOTES PERICO",
            "taxpayer_nif": "12345678E",
            "taxable_base": 2000.00,
        }

    def test_generate_model_123T_amount_positive(self):
        expected_result = "<T303020263T0000><AUX>                                                                      v1.0    12345678X                                                                                                                                                                                                                     </AUX><T30301000> U12345678EDE LOS PALOTES PERICO                                                           20263T22322222200000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </T30301000><T30303000>                0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     </T30303000><T303DID00>           ES0012341234123412341234                                                                                                                                                   0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </T303DID00></T303020263T0000>"  # noqa
        self.datos_validos["iban"] = "ES0012341234123412341234"

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        datos_fichero = modelo.generate(datos_modelo)
        self.assertEqual(datos_fichero, expected_result)

    def test_generate_model_123T_amount_negative(self):
        expected_result = "<T303020263T0000><AUX>                                                                      v1.0    12345678X                                                                                                                                                                                                                     </AUX><T30301000> C12345678EDE LOS PALOTES PERICO                                                           20263T22322222200000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </T30301000><T30303000>                0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     </T30303000><T303DID00>                                                                                                                                                                                      0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </T303DID00></T303020263T0000>"  # noqa
        self.datos_validos["iban"] = "ES0012341234123412341234"
        self.datos_validos["goods_services_expenses"] = 2500.0
        self.datos_validos["vat_goods_services_expenses"] = 525.0

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        datos_fichero = modelo.generate(datos_modelo)
        self.assertEqual(datos_fichero, expected_result)

    def test_generate_model_q4_amount_positive(self):
        expected_result = "<T303020264T0000><AUX>                                                                      v1.0    12345678X                                                                                                                                                                                                                     </AUX><T30301000> U12345678EDE LOS PALOTES PERICO                                                           20264T22322222200000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </T30301000><T30303000>                0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     </T30303000><T30304000> A018612                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </T30304000><T30305000>    0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 </T30305000><T303DID00>           ES0012341234123412341234                                                                                                                                                   0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </T303DID00></T303020264T0000>"  # noqa
        self.datos_validos["iban"] = "ES0012341234123412341234"
        self.datos_validos["period"] = Period.FOURTH_QUARTER
        self.datos_validos["annual_operations_volume"] = 6000.0

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        datos_fichero = modelo.generate(datos_modelo)
        self.assertEqual(datos_fichero, expected_result)

    def test_generate_model_q4_amount_negative(self):
        expected_result = "<T303020264T0000><AUX>                                                                      v1.0    12345678X                                                                                                                                                                                                                     </AUX><T30301000> D12345678EDE LOS PALOTES PERICO                                                           20264T22322222200000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </T30301000><T30303000>                0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     </T30303000><T30304000> A018612                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </T30304000><T30305000>    0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000 00000   0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 </T30305000><T303DID00>                                                                                                                                                                                      0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </T303DID00></T303020264T0000>"  # noqa
        self.datos_validos["iban"] = "ES0012341234123412341234"
        self.datos_validos["period"] = Period.FOURTH_QUARTER
        self.datos_validos["goods_services_expenses"] = 2500.0
        self.datos_validos["vat_goods_services_expenses"] = 525.0
        self.datos_validos["annual_operations_volume"] = 6000.0

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        datos_fichero = modelo.generate(datos_modelo)
        self.assertEqual(datos_fichero, expected_result)

    def test_generate_model_without_iban(self):
        expected_result = "<T303020263T0000><AUX>                                                                      v1.0    12345678X                                                                                                                                                                                                                     </AUX><T30301000> I12345678EDE LOS PALOTES PERICO                                                           20263T22322222200000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </T30301000><T30303000>                0000000000000000000000000000000000                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     </T30303000><T303DID00>                                                                                                                                                                                      0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </T303DID00></T303020263T0000>"  # noqa

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        datos_fichero = modelo.generate(datos_modelo)
        self.assertEqual(datos_fichero, expected_result)

    def test_generate_did_with_iban_none(self):
        self.datos_validos["iban"] = None

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)
        did = modelo._generate_dp303_did(datos_modelo)

        expected_prefix = "<T303DID00>" + (" " * 45)
        self.assertTrue(did.startswith(expected_prefix))

    def test_declaration_type_zero_amount(self):
        self.datos_validos["taxable_base"] = 0.0

        datos_modelo = Modelo303Datos(**self.datos_validos)
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)

        self.assertEqual(modelo._declaration_type(datos_modelo), "N")

    def test_to_cents_negative(self):
        modelo = Modelo303Factory.get_modelo303_generator(self.anyo_fiscal)

        self.assertEqual(modelo._to_cents_zfill(-12.34, 5), "N1234")
        centimos = modelo._to_cents_str(-1.23)
        self.assertTrue(centimos.startswith("N"))
        self.assertEqual(len(centimos), 17)


if __name__ == "__main__":
    unittest.main()
